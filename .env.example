# ==============================================================================
# BIS TRUST COPILOT — ENVIRONMENT TEMPLATE (.env.example)
# Security Notice: NEVER commit actual production keys or secrets to Git.
# ==============================================================================

PORT=3000
NODE_ENV=production

# Server-Side API Keys (Never exposed to browser frontend)
GEMINI_API_KEY=your_gemini_api_key_here

# Security & CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000